# Copie este arquivo para .env e ajuste se precisar
PORT=3000
# Dica: use 127.0.0.1 em vez de localhost (evita uma espera a cada conexão no Windows)
DATABASE_URL=postgres://notas:notas123@127.0.0.1:5432/notas
# Use true se o seu Postgres exigir SSL (ex.: Supabase, Neon, Render)
PGSSL=false

# Fuso horário usado para virar o mês da pontuação
APP_TZ=America/Fortaleza
